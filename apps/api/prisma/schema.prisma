generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  new
  warehouse
  shipped
  done
  archived
}

enum PackagingType {
  pallets
  boxes
}

enum InvoiceStatus {
  new
  awaiting_payment
  paid
  cancelled
}

enum RateUnit {
  pallet
  boxes
}

model Client {
  id           Int              @id @default(autoincrement())
  telegramId   String           @unique @map("telegram_id")
  username     String?
  firstName    String?          @map("first_name")
  lastName     String?          @map("last_name")
  phone        String?
  email        String?
  consentGiven Boolean          @default(false) @map("consent_given")
  consentAt    DateTime?        @map("consent_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  requests     ShipmentRequest[]
  counterparties CounterpartyContact[]

  @@map("clients")
}

model Counterparty {
  id                    Int                   @id @default(autoincrement())
  name                  String
  shortName             String?               @map("short_name")
  orgType               String?               @map("org_type")
  orgStatus             String?               @map("org_status")
  inn                   String?               @unique
  kpp                   String?
  ogrn                  String?
  address               String?
  account               String?               @map("account")
  bik                   String?
  correspondentAccount  String?               @map("correspondent_account")
  bank                  String?
  director              String?
  directorPost          String?               @map("director_post")
  contract              String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  contacts              CounterpartyContact[]
  invoices              Invoice[]
  bankTransactions      BankTransaction[]
  balance               CounterpartyBalance?

  @@map("counterparties")
}

model CounterpartyContact {
  id             Int          @id @default(autoincrement())
  counterpartyId Int          @map("counterparty_id")
  clientId       Int          @map("client_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  client         Client       @relation(fields: [clientId], references: [id])

  @@unique([counterpartyId, clientId])
  @@map("counterparty_contacts")
}

model Manager {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  fieldChanges RequestFieldHistory[]

  @@map("managers")
}

model ShipmentRequest {
  id          Int                    @id @default(autoincrement())
  clientId    Int                    @map("client_id")
  cityId      Int                    @map("city_id")
  city        String                 @default("")
  deliveryDate DateTime             @map("delivery_date")
  volume      Float?
  size        String
  weight      Float?
  boxCount    Int                    @map("box_count")
  boxTypeId   Int?                   @map("box_type_id")
  packagingType PackagingType        @default(boxes) @map("packaging_type")
  comment     String?
  status      RequestStatus          @default(new)
  isRead      Boolean                @default(false) @map("is_read")
  deliveryTypeId Int?                @map("delivery_type_id")
  mpAccountDate DateTime?            @map("mp_account_date")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  client       Client                 @relation(fields: [clientId], references: [id])
  cityRef      City                   @relation(fields: [cityId], references: [id])
  boxType      BoxType?               @relation(fields: [boxTypeId], references: [id])
  deliveryType DeliveryType?          @relation(fields: [deliveryTypeId], references: [id])
  history      RequestStatusHistory[]
  fieldHistory RequestFieldHistory[]
  services     RequestService[]
  photos       RequestPhoto[]
  invoices     Invoice[]

  @@map("shipment_requests")
}

model BoxType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  minVolumeM3 Float    @default(0) @map("min_volume_m3")
  maxVolumeM3 Float    @map("max_volume_m3")
  hint        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests    ShipmentRequest[]
  rates       PriceRate[]

  @@map("box_types")
}

model City {
  id        Int         @id @default(autoincrement())
  shortName String      @unique @map("short_name")
  fullName  String      @map("full_name")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  rates     PriceRate[]
  requests  ShipmentRequest[]
  schedules DeliverySchedule[]

  @@map("cities")
}

model CityFbs {
  id        Int      @id @default(autoincrement())
  shortName String   @unique @map("short_name")
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  schedules DeliveryScheduleFbs[]

  @@map("cities_fbs")
}

model PalletType {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  minValue  Int       @map("min_value")
  maxValue  Int?      @map("max_value")
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  rates     PriceRate[]

  @@map("pallet_types")
}

model PriceRate {
  id            Int          @id @default(autoincrement())
  cityId        Int          @map("city_id")
  unit          RateUnit
  boxTypeId     Int?         @map("box_type_id")
  palletTypeId  Int?         @map("pallet_type_id")
  price         Int
  comment       String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  city          City         @relation(fields: [cityId], references: [id])
  boxType       BoxType?     @relation(fields: [boxTypeId], references: [id])
  palletType    PalletType?  @relation(fields: [palletTypeId], references: [id])

  @@index([cityId, unit])
  @@index([cityId, unit, boxTypeId])
  @@index([cityId, unit, palletTypeId])
  @@map("price_rates")
}

model Invoice {
  id              Int           @id @default(autoincrement())
  number          String        @unique
  date            DateTime      @default(now())
  counterpartyId  Int           @map("counterparty_id")
  requestId       Int?          @map("request_id")
  status          InvoiceStatus @default(new)
  isPaid          Boolean       @default(false) @map("is_paid")
  paidAt          DateTime?     @map("paid_at")
  
  // T-Bank payment fields
  tbankPaymentId  String?       @unique @map("tbank_payment_id")
  tbankPaymentUrl String?       @map("tbank_payment_url")
  tbankOrderId    String?       @unique @map("tbank_order_id")
  amount          Float         @default(0)
  
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  counterparty    Counterparty     @relation(fields: [counterpartyId], references: [id])
  request         ShipmentRequest? @relation(fields: [requestId], references: [id])
  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  description String
  quantity    Float    @default(1)
  unit        String   @default("шт")
  price       Float
  amount      Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model DeliverySchedule {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  destination   String   @default("")
  deliveryDate  DateTime @map("delivery_date")
  acceptDays    String   @map("accept_days")
  createdAt     DateTime @default(now()) @map("created_at")

  cityRef       City     @relation(fields: [cityId], references: [id])

  @@map("delivery_schedules")
}

model DeliveryScheduleFbs {
  id            Int      @id @default(autoincrement())
  cityId        Int      @map("city_id")
  destination   String   @default("")
  deliveryDate  DateTime @map("delivery_date")
  acceptDays    String   @map("accept_days")
  createdAt     DateTime @default(now()) @map("created_at")

  cityRef       CityFbs  @relation(fields: [cityId], references: [id])

  @@map("delivery_schedules_fbs")
}

model PriceFbs {
  id          Int      @id @default(autoincrement())
  destination String
  volume      String
  price       String
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("prices_fbs")
}

model RequestStatusHistory {
  id        Int           @id @default(autoincrement())
  requestId Int           @map("request_id")
  oldStatus RequestStatus @map("old_status")
  newStatus RequestStatus @map("new_status")
  changedAt DateTime      @default(now()) @map("changed_at")

  request   ShipmentRequest @relation(fields: [requestId], references: [id])

  @@map("request_status_history")
}

model RequestService {
  id          Int             @id @default(autoincrement())
  requestId   Int             @map("request_id")
  description String
  unit        String          @default("шт")
  quantity    Float           @default(1)
  price       Float           @default(0)
  amount      Float           @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")

  request     ShipmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_services")
}

model RequestFieldHistory {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  managerId Int      @map("manager_id")
  field     String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  request   ShipmentRequest @relation(fields: [requestId], references: [id])
  manager   Manager         @relation(fields: [managerId], references: [id])

  @@map("request_field_history")
}

model DeliveryType {
  id        Int                  @id @default(autoincrement())
  name      String               @unique
  note      String?              @map("note")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  requests            ShipmentRequest[]
  clientServicePrices ClientServicePrice[]

  @@map("delivery_types")
}

model ServicePrice {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  unit      String   @default("услуга")
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_prices")
}

enum TransactionStatus {
  new
  matched
  unmatched
  ignored
}

model BankImportBatch {
  id            String   @id @default(uuid())
  fileName      String   @map("file_name")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  account       String
  totalIncoming Float    @map("total_incoming")
  totalOutgoing Float    @map("total_outgoing")
  openBalance   Float    @map("open_balance")
  closeBalance  Float    @map("close_balance")
  recordCount   Int      @map("record_count")
  source        String   @default("manual")
  importedAt    DateTime @default(now()) @map("imported_at")

  transactions  BankTransaction[]

  @@map("bank_import_batches")
}

model BankTransaction {
  id                  Int               @id @default(autoincrement())
  documentNumber      String            @map("document_number")
  documentDate        DateTime          @map("document_date")
  amount              Float
  direction           String

  payerName           String            @map("payer_name")
  payerInn            String?           @map("payer_inn")
  payerAccount        String?           @map("payer_account")
  payerBik            String?           @map("payer_bik")
  payerBank           String?           @map("payer_bank")

  recipientName       String            @map("recipient_name")
  recipientInn        String?           @map("recipient_inn")
  recipientAccount    String?           @map("recipient_account")

  purpose             String

  counterpartyId      Int?              @map("counterparty_id")
  counterparty        Counterparty?     @relation(fields: [counterpartyId], references: [id])

  invoiceNumbers      String[]          @map("invoice_numbers")

  status              TransactionStatus @default(new)
  matchedAt           DateTime?         @map("matched_at")

  importBatchId       String            @map("import_batch_id")
  importBatch         BankImportBatch   @relation(fields: [importBatchId], references: [id])
  rawData             Json?             @map("raw_data")

  createdAt           DateTime          @default(now()) @map("created_at")

  @@unique([documentNumber, documentDate, amount, payerInn])
  @@map("bank_transactions")
}

model CounterpartyBalance {
  id               Int          @id @default(autoincrement())
  counterpartyId   Int          @unique @map("counterparty_id")
  totalBilled      Float        @default(0) @map("total_billed")
  totalPaid        Float        @default(0) @map("total_paid")
  balance          Float        @default(0)
  lastUpdated      DateTime     @default(now()) @map("last_updated")

  counterparty     Counterparty @relation(fields: [counterpartyId], references: [id])

  @@map("counterparty_balances")
}

model ClientServicePrice {
  id             Int          @id @default(autoincrement())
  deliveryTypeId Int          @map("delivery_type_id")
  name           String
  price          Float
  unit           String       @default("шт")
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  deliveryType   DeliveryType @relation(fields: [deliveryTypeId], references: [id])

  @@map("client_service_prices")
}

model WarehouseWorker {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique @map("telegram_id")
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("warehouse_workers")
}

model RequestPhoto {
  id         Int             @id @default(autoincrement())
  requestId  Int             @map("request_id")
  fileId     String          @map("file_id")
  fileUrl    String?         @map("file_url")
  uploadedAt DateTime        @default(now()) @map("uploaded_at")
  uploadedBy String          @map("uploaded_by")

  request    ShipmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_photos")
}
